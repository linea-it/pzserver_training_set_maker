#!/usr/bin/env python3

import argparse
import datetime
import hashlib
import os
import time
from pathlib import Path

import numpy as np
import pandas as pd

import lsdb
from dask.distributed import Client
from executor import get_executor
from photometric_dataset import PhotometricDatasetResolver
from product_handle import ProductHandle, create_output
from utils import (
    copy_directory,
    copy_file,
    copy_files_by_extensions,
    create_logdir,
    dump_yml,
    load_yml,
    setup_logger,
)


class Runner:
    """Runner for TSM pipeline
    This class handles the execution of the TSM pipeline, including loading configurations,
    managing inputs and outputs, and executing the cross-matching process.
    """

    def __init__(self, config, cwd=".") -> None:
        """Initialize the Runner with configuration and working directory.

        Args:
            config (str): Path to the configuration file.
            cwd (str, optional): Working directory. Defaults to ".".

        Configuration file should contain:
            - executor: Executor configuration for Dask.
            - output_name: Name of the output file.
            - output_format: Format of the output file (e.g., parquet).
            - output_root_dir: Root directory for outputs.
            - output_dir: Directory for outputs relative to output_root_dir.
            - inputs: Dictionary containing input data specifications.
            - param: Dictionary containing parameters for the pipeline.
        """
        self.config = config

        # Create logs directory
        self.logdir = create_logdir(cwd)

        # Setup logger
        self.logger, logname = setup_logger(logdir=self.logdir)

        # Set up working directory
        self.cwd = cwd

        # Set up process info
        self.process_info_path = Path(self.cwd, "process.yml")

        # Creating process info yaml
        if not self.process_info_path.is_file():
            self.process_info_path.touch()

        # Initialize process info
        self.process_info = {}

        # Set logfile in process info
        self.add_info("log_file", str(Path(self.logdir.name, logname)))

        # Set up initial time tracking
        self.add_info("start_time", datetime.datetime.now())
        self.start_time = time.time()
        self.end_time = None

        # Loading config
        pipe_config = load_yml(self.config)

        self.logger.debug("Configurations: %s", pipe_config)

        # Retrieves the output directory to copy the output to at the end of processing.
        self.output_root_dir = pipe_config.get("output_root_dir", ".")
        self.output_dir = pipe_config.get("output_dir", "out")
        self.output_name = pipe_config.get("output_name", "tsm")
        self.output_format = pipe_config.get("output_format", None)

        if not Path(self.output_root_dir).is_absolute():
            self.output_root_dir = str(Path(self.cwd, self.output_root_dir))

        # Loading inputs
        self.inputs = pipe_config.get("inputs")
        self.logger.info("Inputs: %s", self.inputs)

        # Loading parameters
        self.param = pipe_config.get("param", {})
        self.param["crossmatch"] = self.param.get("crossmatch", {})

        self.specz_suffix = "_specz"
        self.param["crossmatch"]["suffixes"] = [self.specz_suffix, ""]

        self.logger.info("Params: %s", self.param)

        # Set executors
        self.executors = pipe_config.get("executor")

        # Create output dir
        output_full_dir = Path(self.output_root_dir, self.output_dir)
        os.makedirs(output_full_dir, exist_ok=True)

        # Get dask executor
        self.cluster = get_executor(self.executors)
        self.photometric_dataset_resolver = PhotometricDatasetResolver(
            inputs=self.inputs,
            param=self.param,
            cwd=self.cwd,
            logger=self.logger,
            add_info=self.add_info,
        )

    def __enter__(self):
        return self

    def add_info(self, key, value):
        """Add info in process.yaml"""

        self.process_info[key] = value  # type: ignore
        dump_yml(self.process_info_path, self.process_info)

    def run(self):
        """Run TSM"""

        specz = self.inputs.get("specz")
        if len(specz) > 1:
            self.logger.warn(f"more than one specz was selected: {specz}")

        specz = specz.pop()
        self.logger.debug(f"Specz used: {specz}")

        columns = specz.get("columns", {})
        self.__validate_required_specz_columns(columns)
        ra = columns.get("ra", "ra")
        dec = columns.get("dec", "dec")

        specz_path = str(specz.get("path"))
        specz_format = str(specz.get("format", "")).lower()
        specz_is_hats = (
            specz_format == "hats"
            or self.photometric_dataset_resolver.is_hats_catalog_path(specz_path)
        )

        with Client(self.cluster) as client:
            if specz_is_hats:
                specz_catalog_columns = (
                    self.photometric_dataset_resolver.get_catalog_columns(specz_path)
                )
                self.logger.debug(
                    "Opening specz as HATS catalog with projected columns: path=%s columns=%s",
                    specz_path,
                    specz_catalog_columns,
                )
                specz_open_args = {}
                if specz_catalog_columns:
                    specz_open_args["columns"] = specz_catalog_columns
                specz_df = lsdb.open_catalog(specz_path, **specz_open_args)
            else:
                df = ProductHandle().df_from_file(specz_path)
                specz_df = lsdb.from_dataframe(
                    df, use_pyarrow_types=False, ra_column=ra, dec_column=dec
                )

            selected_cols = self.param.get("selected_cols", [])
            if selected_cols is None:
                selected_cols = []
            if not isinstance(selected_cols, list):
                raise ValueError("param.selected_cols must be a list")

            dataset, dataset_path = self.photometric_dataset_resolver.resolve(
                client=client,
                selected_cols=selected_cols,
            )
            self.add_info("photometric_dataset_path", dataset_path)
            cm_args = self.param.get("crossmatch", {})
            cm_args["suffix_method"] = "all_columns"
            self.logger.debug("Crossmatch args: %s", cm_args)

            try:
                data = specz_df.crossmatch(dataset, **cm_args)
            except ValueError as err:
                if "size 0 inputs" in str(err):
                    self.logger.exception("No cross matches were found!")
                    raise
                self.logger.exception("Error when cross-matching")
                raise

            split_method = self.param.get("split_method", "random")
            train_fraction = self.param.get("train_fraction", 0.7)
            random_seed = self.param.get("random_seed", None)

            try:
                data = self.__split_train_test(
                    data, split_method, train_fraction, random_seed
                )
            except ValueError:
                self.logger.exception("Invalid parameters for train/test split")
                raise

            suffix = self.specz_suffix
            data_columns = list(data.columns)
            specz_columns = {}

            self.logger.debug(f"Output columns: {data_columns}")

            for col in data_columns:
                if col.endswith(suffix):
                    specz_columns[col] = col.removesuffix(suffix)

            for key, value in specz_columns.copy().items():
                if value in data_columns:
                    del specz_columns[key]

            if specz_columns:
                self.logger.debug(f"Renaming columns: {specz_columns}")
                data = data.rename(columns=specz_columns)

            if not self.output_format:
                self.output_format = (
                    "hats" if specz_is_hats else specz.get("format", "parquet")
                )

            if self.output_format:
                self.output_format = str(self.output_format).lower()

            if self.output_format == "specz":
                self.output_format = (
                    "hats"
                    if specz_is_hats
                    else str(specz.get("format", "parquet")).lower()
                )

            hats_ra_col, hats_dec_col = ra, dec
            if self.output_format == "hats":
                data = self.__drop_hats_partition_columns(data)
                hats_ra_col, hats_dec_col = self.__resolve_hats_coordinate_columns(
                    list(data.columns),
                    ra_column=ra,
                    dec_column=dec,
                )

            output_product = create_output(
                data,
                self.cwd,
                self.output_root_dir,
                self.output_dir,
                self.output_name,
                self.output_format,
                ra_column=hats_ra_col,
                dec_column=hats_dec_col,
                temp_dir=Path(self.cwd, "temp"),
                client=client,
                logger=self.logger,
            )

            columns_suffix = {}
            for k, v in columns.items():
                if v:
                    columns_suffix[k] = f"{v}{self.specz_suffix}"

            columns_assoc = self.__get_columns_associations(
                columns_suffix, specz_columns
            )

            self.__register_outputs(self.output_root_dir, output_product, columns_assoc)

        self.end_time = time.time() - self.start_time
        self.logger.info("Time elapsed: %s", str(self.end_time))

        copy_files_by_extensions(".", self.logdir, [".log", ".err", ".out"])
        copy_file(
            self.config, str(Path(self.output_root_dir, self.output_dir, "config.yml"))
        )
        # Also copying to the working directory for consistency
        copy_file(self.config, str(Path(self.cwd, "config.yml")))
        copy_directory(
            self.logdir,
            str(Path(self.output_root_dir, self.output_dir, "process_info")),
        )

    def __get_columns_associations(self, columns, specz_columns):
        """Get columns associations of the product output

        Args:
            columns (dict): used columns
            specz_columns (dict): output columns
        """

        associations = {
            k: specz_columns[v] if v in specz_columns else v for k, v in columns.items()
        }
        required = {"ra", "dec", "z"}
        missing = sorted(required - set(associations.keys()))
        if missing:
            raise ValueError(
                f"Missing required specz column association(s): {', '.join(missing)}"
            )
        return associations

    def __validate_required_specz_columns(self, columns):
        """Validate required specz coordinate/redshift columns in config."""
        if not isinstance(columns, dict):
            raise ValueError("inputs.specz[0].columns must be a dictionary.")

        required = ("ra", "dec", "z")
        missing = [key for key in required if not columns.get(key)]
        if missing:
            raise ValueError(
                "inputs.specz[0].columns must define required keys: "
                "ra, dec, z. Missing: " + ", ".join(missing)
            )

    def __split_train_test(
        self,
        df,
        split_method: str = "random",
        train_fraction: float = 0.7,
        random_seed: int | None = None,
    ) -> pd.DataFrame:
        """
        Add a boolean column 'is_training_set' to the dataframe.

        Args:
            df (pd.DataFrame): Crossmatching result table.
            split_method (str): Method used to split dataset. Currently supports: "random".
            train_fraction (float): Fraction of objects assigned to training set
                (0 < train_fraction < 1).
            random_seed (int or None): Random seed for reproducibility.

        Return:
            pd.DataFrame: Copy of input DataFrame with new column 'is_training_set'.
        """

        if not 0 < train_fraction < 1:
            raise ValueError("train_fraction must be between 0 and 1")

        if split_method != "random":
            raise ValueError(f"Unknown split_method: {split_method}")

        if self.__is_dask_dataframe(df):
            seed = int(random_seed) if random_seed is not None else int(time.time())
            if hasattr(df, "_ddf"):
                meta_source = df._ddf._meta
            else:
                meta_source = df._meta

            meta = meta_source.assign(is_training_set=pd.Series(dtype="int64"))

            def _assign_flag(partition, partition_info=None):
                partition = partition.copy()
                partition_number = (
                    int(partition_info.get("number", 0))
                    if isinstance(partition_info, dict)
                    else 0
                )
                # Stable per-partition seed to keep output reproducible when random_seed is provided.
                partition_seed = int(
                    hashlib.sha256(
                        f"{seed}:{partition_number}".encode("utf-8")
                    ).hexdigest()[:8],
                    16,
                )
                rng = np.random.default_rng(partition_seed)
                partition["is_training_set"] = (
                    rng.random(len(partition)) < train_fraction
                ).astype(int)
                return partition

            return df.map_partitions(
                _assign_flag,
                meta=meta,
                partition_info=True,
            )

        if random_seed is not None:
            np.random.seed(random_seed)

        df = df.copy()
        df["is_training_set"] = (np.random.rand(len(df)) < train_fraction).astype(int)
        return df

    @staticmethod
    def __is_dask_dataframe(obj):
        """Check if object looks like a Dask DataFrame."""
        return all(
            hasattr(obj, attr) for attr in ("map_partitions", "compute", "npartitions")
        )

    def __resolve_hats_coordinate_columns(
        self, columns, ra_column="ra", dec_column="dec"
    ):
        """Resolve coordinate columns for HATS export."""
        colset = set(columns)
        if ra_column in colset and dec_column in colset:
            return ra_column, dec_column

        if "ra" in colset and "dec" in colset:
            return "ra", "dec"

        raise ValueError(
            f"HATS output requires coordinate columns. Not found: ra='{ra_column}', dec='{dec_column}'."
        )

    def __drop_hats_partition_columns(self, data):
        """Drop HATS partition columns that should not be part of output payload."""
        partition_columns = {
            "Norder",
            "Dir",
            "Npix",
            "Norder_specz",
            "Dir_specz",
            "Npix_specz",
        }
        available = set(getattr(data, "columns", []))
        to_drop = sorted(partition_columns.intersection(available))
        if not to_drop:
            return data

        self.logger.debug("Dropping HATS partition columns from output: %s", to_drop)
        return data.drop(columns=to_drop, errors="ignore")

    def __register_outputs(self, root_dir, filepath, assoc, role="main"):
        """Register outputs in process.yml

        Args:
            root_dir (str): output root dir
            filepath (str): output path
            assoc (dic): columns association
            role (str, optional): role name. Defaults to 'main'.
        """

        outpath = str(Path(filepath))
        outputs = self.process_info.get("outputs", [])  # type: ignore
        outputs.append(
            {
                "path": outpath,
                "root_dir": root_dir,
                "role": role,
                "columns_assoc": assoc,
            }
        )
        self.add_info("outputs", outputs)

    def __add_train_flag(self):
        """Add train/test flag"""
        raise NotImplementedError

    def __exit__(self, exc_type, exc_value, traceback):

        self.cluster.close()
        self.add_info("end_time", datetime.datetime.now())

        if exc_type:
            self.logger.error("%s: %s", exc_type.__name__, exc_value)
            self.logger.debug("Traceback: %s", traceback)
            self.add_info("status", "Failed")
        else:
            self.add_info("status", "Successful")

        copy_file(
            self.process_info_path,
            str(Path(self.output_root_dir, self.output_dir, "process.yml")),
        )


if __name__ == "__main__":
    # Create the parser and add arguments
    parser = argparse.ArgumentParser()
    parser.add_argument(dest="config_path", help="yaml config path")
    parser.add_argument(
        dest="cwd", nargs="?", help="processing dir", default=os.getcwd()
    )

    args = parser.parse_args()
    config_path = args.config_path

    # Run pipeline
    with Runner(config_path, args.cwd) as tsmrun:
        tsmrun.run()
